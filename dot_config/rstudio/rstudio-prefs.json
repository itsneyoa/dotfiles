{
    "initial_working_directory": "~/Code",
    "posix_terminal_shell": "custom",
    "editor_theme": "Dracula",
    "jobs_tab_visibility": "shown",
    "enable_splash_screen": false,
    "default_open_project_location": "~/Code",
    "rainbow_parentheses": true,
    "reformat_on_save": true,
    "strip_trailing_whitespace": true,
    "line_ending_conversion": "posix",
    "code_formatter": "external",
    "syntax_color_console": true,
    "spelling_dictionary_language": "en_GB",
    "custom_shell_command": "/opt/homebrew/Cellar/fish/4.1.1/bin/fish",
    "default_project_location": "~/Library/CloudStorage/OneDrive-NewcastleUniversity/Documents/BMS3025/R",
    "highlight_selected_line": true,
    "show_margin": false,
    "console_double_click_select": true,
    "terminal_close_behavior": "clean",
    "highlight_r_function_calls": true,
    "code_formatter_external_command": "/opt/homebrew/bin/air format",
    "panes": {
        "quadrants": [
            "Source",
            "Console",
            "TabSet1",
            "TabSet2"
        ],
        "tabSet1": [
            "Environment",
            "History",
            "Files",
            "Help",
            "Viewer",
            "Presentation"
        ],
        "tabSet2": [
            "Plots",
            "Packages",
            "Presentations"
        ],
        "hiddenTabSet": [
            "Connections",
            "Build",
            "VCS",
            "Tutorial"
        ],
        "console_left_on_top": false,
        "console_right_on_top": true,
        "additional_source_columns": 0
    },
    "source_with_echo": true,
    "wrap_tab_navigation": false
}